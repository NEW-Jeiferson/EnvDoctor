{
  "name": "nombres-de-ramas",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": [
        "refs/heads/main",
        "refs/heads/develop",
        "refs/heads/feature/*",
        "refs/heads/docs/*",
        "refs/heads/hotfix/*",
        "refs/heads/dependabot/**/*"
      ]
    }
  },
  "rules": [
    {
      "type": "creation"
    }
  ]
}